<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>iNat TrailCam Audio Booster</AssemblyName>
    <RootNamespace>INatTrailCamAudioBooster</RootNamespace>
    <Version>2.0.2</Version>
    <FileVersion>2.0.2.0</FileVersion>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <ApplicationIcon>assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\inat-trailcam-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>assets\inat-trailcam-logo.png</Link>
    </Content>
    <Content Include="assets\logo-polones-footer.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>assets\logo-polones-footer.png</Link>
    </Content>

    <Content Include="..\..\vendor\ffmpeg\bin\ffmpeg.exe" Condition="Exists('..\..\vendor\ffmpeg\bin\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>tools\ffmpeg\bin\ffmpeg.exe</Link>
    </Content>
    <Content Include="..\..\vendor\ffmpeg\bin\ffprobe.exe" Condition="Exists('..\..\vendor\ffmpeg\bin\ffprobe.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>tools\ffmpeg\bin\ffprobe.exe</Link>
    </Content>
    <Content Include="..\..\vendor\ffmpeg\LICENSES\**\*" Condition="Exists('..\..\vendor\ffmpeg\LICENSES')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>LICENSES\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
